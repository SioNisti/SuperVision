<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SuperVision"
             xmlns:widget="using:SuperVision.Widgets.GrindInfo"
             x:Class="SuperVision.Widgets.GrindInfo.GrindInfoView"
             x:DataType="widget:GrindInfoViewModel"
             HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <local:ColorToBrushConverter x:Key="ColorToBrush"/>
    </UserControl.Resources>

    <Border Background="{Binding BgColor, Converter={StaticResource ColorToBrush}}" Padding="10,5">
        <TextBlock
            Text="{Binding GrindInfos}" 
            Foreground="{Binding FontColor, Converter={StaticResource ColorToBrush}}" 
            FontSize="{Binding FontSize}"
            FontFamily="{Binding FontName}"
            HorizontalAlignment="{Binding ContentTextAlignment}"/>
    </Border>
</UserControl>