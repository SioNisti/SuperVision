<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SuperVision"
             xmlns:widget="using:SuperVision.Widgets.Attempts"
             x:Class="SuperVision.Widgets.Attempts.AttemptsView"
             x:DataType="widget:AttemptsViewModel"
             HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <local:ColorToBrushConverter x:Key="ColorToBrush"/>
    </UserControl.Resources>
    
    <Border Background="{Binding BgColor, Converter={StaticResource ColorToBrush}}" Padding="10,5">
        <Grid ColumnDefinitions="Auto, *">
            <TextBlock Grid.Column="0" 
                       Text="{Binding CourseName}" 
                       Foreground="{Binding FontColor, Converter={StaticResource ColorToBrush}}" 
                       FontSize="{Binding FontSize}"
                       FontFamily="{Binding FontName}"
                       HorizontalAlignment="Left"/>

            <TextBlock Grid.Column="1" 
                       Text="{Binding AttemptRatio}" 
                       Foreground="{Binding FontColor, Converter={StaticResource ColorToBrush}}" 
                       FontSize="{Binding FontSize}"
                       FontFamily="{Binding FontName}"
                       HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</UserControl>